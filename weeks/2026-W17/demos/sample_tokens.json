{
  "colors": {
    "surface": {
      "base": "#ffffff",
      "muted": "#f5f7fb",
      "inverse": "#0f172a"
    },
    "text": {
      "primary": "#0f172a",
      "secondary": "#475569",
      "inverse": "#f8fafc"
    },
    "accent": {
      "brand": "#4f46e5",
      "success": "#15803d",
      "warning": "#d97706"
    },
    "border": {
      "subtle": "#cbd5e1"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "pill": "999px"
  },
  "typography": {
    "fontFamily": {
      "base": "Inter, system-ui, sans-serif"
    },
    "fontSize": {
      "body": "16px",
      "label": "14px",
      "hero": "32px"
    }
  },
  "semantic": {
    "button": {
      "primary": {
        "bg": "{colors.accent.brand}",
        "fg": "{colors.text.inverse}"
      },
      "secondary": {
        "bg": "{colors.surface.muted}",
        "fg": "{colors.text.primary}",
        "border": "{colors.border.subtle}"
      }
    },
    "banner": {
      "success": {
        "bg": "{colors.accent.success}",
        "fg": "{colors.text.inverse}"
      },
      "warning": {
        "bg": "{colors.surface.muted}",
        "fg": "{colors.accent.warning}"
      }
    },
    "badge": {
      "info": {
        "bg": "{colors.accent.info}"
      }
    }
  },
  "checks": [
    {
      "name": "body-on-surface",
      "foreground": "colors.text.primary",
      "background": "colors.surface.base",
      "minRatio": 4.5
    },
    {
      "name": "secondary-on-muted",
      "foreground": "colors.text.secondary",
      "background": "colors.surface.muted",
      "minRatio": 4.5
    },
    {
      "name": "inverse-on-brand",
      "foreground": "colors.text.inverse",
      "background": "colors.accent.brand",
      "minRatio": 4.5
    },
    {
      "name": "primary-button-pair",
      "foreground": "semantic.button.primary.fg",
      "background": "semantic.button.primary.bg",
      "minRatio": 4.5
    },
    {
      "name": "warning-on-muted",
      "foreground": "semantic.banner.warning.fg",
      "background": "semantic.banner.warning.bg",
      "minRatio": 4.5
    }
  ]
}
